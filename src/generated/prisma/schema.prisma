// Local-only SQLite schema. Money is stored in integer cents everywhere to avoid
// float rounding; `lib/money.ts` owns all formatting.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for migrate/introspect)
// and is passed to PrismaClient via a driver adapter at runtime. See src/lib/db.ts.
datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  reviews   Review[]
  addresses Address[]
  carts     Cart[]
  orders    Order[]

  @@index([createdAt, id])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("IN")
  phone      String
  isDefault  Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, isDefault])
}

model Category {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  // Emoji glyph reused by the generated placeholder art and the category nav.
  glyph    String @default("*")
  sortRank Int    @default(0)

  products Product[]

  @@index([sortRank])
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  brand       String
  description String
  bullets     String // JSON string[] — SQLite has no native array type
  specs       String // JSON Record<string, string>
  priceCents  Int
  // Fake "list price" so the UI can show a strike-through discount. Null = no discount.
  listCents   Int?
  currency    String   @default("INR")
  stock       Int      @default(0)
  imageKeys   String // JSON string[] of keys into public/img/p/<key>.svg
  categoryId  String
  createdAt   DateTime @default(now())

  // Denormalised on purpose: recomputed inside the same transaction that writes a
  // Review, so listing pages never need a per-card aggregate query.
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  // Lowercased "title brand category bullets" blob for LIKE-based search.
  searchText String

  category   Category    @relation(fields: [categoryId], references: [id])
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  // Every index below backs a keyset (cursor) sort. The trailing `id` is the
  // tiebreaker that makes each sort a total order — without it, pagination can
  // duplicate or skip rows across pages.
  @@index([createdAt, id])
  @@index([priceCents, id])
  @@index([ratingAvg, id])
  @@index([categoryId, createdAt, id])
  @@index([categoryId, priceCents, id])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1..5, enforced by zod at the edge
  title     String
  body      String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One review per user per product.
  @@unique([productId, userId])
  @@index([productId, createdAt, id])
  @@index([productId, rating, id])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("open") // open | converted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId, status])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  qty       Int
  addedAt   DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Order {
  id     String @id @default(cuid())
  // Human-facing reference shown in the UI and order confirmation.
  number String @unique
  userId String

  status String @default("placed") // placed | shipped | delivered | cancelled

  // Address is snapshotted as text so order history stays truthful even if the
  // user later edits or deletes the address record.
  shipToName    String
  shipToLine1   String
  shipToLine2   String?
  shipToCity    String
  shipToState   String
  shipToPostal  String
  shipToCountry String
  shipToPhone   String
  addressId     String?

  subtotalCents Int
  shippingCents Int
  taxCents      Int
  totalCents    Int
  currency      String @default("INR")

  deliveryOption String // standard | express
  // Mock payment only — we store a display label, never card data.
  paymentLabel   String

  // Guards against double-submit; the client sends a stable key per attempt.
  idempotencyKey String   @unique
  placedAt       DateTime @default(now())
  etaAt          DateTime

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]

  @@index([userId, placedAt, id])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  // Snapshots: what the customer actually bought, at the price they paid.
  titleSnapshot String
  imageSnapshot String
  slugSnapshot  String
  unitCents     Int
  qty           Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}
