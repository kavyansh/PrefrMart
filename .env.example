# Copy to `.env` before running. `npm run dev` fails fast if AUTH_SECRET is missing/short.

# Local SQLite file. Relative paths are resolved from the project root.
DATABASE_URL="file:./prisma/dev.db"

# Session signing key (HS256). Must be >= 32 chars.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-at-least-32-random-characters-long"

# OAuth providers. Required — the app refuses to boot without them.
# Google:  https://console.cloud.google.com/apis/credentials
#          Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# GitHub:  https://github.com/settings/developers
#          Authorisation callback URL: http://localhost:3000/api/auth/callback/github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
