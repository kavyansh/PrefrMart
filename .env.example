# Copy to `.env` before running. `pnpm dev` fails fast if AUTH_SECRET is missing/short.

# Local SQLite file. Relative paths are resolved from the project root.
DATABASE_URL="file:./prisma/dev.db"

# Session signing key (HS256). Must be >= 32 chars.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-at-least-32-random-characters-long"
