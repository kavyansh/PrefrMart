# Copy to `.env` before running. `npm run dev` fails fast if AUTH_SECRET is missing/short.

# Neon Postgres, pooled (pgbouncer) endpoint — note the `-pooler` in the host.
# `sslmode=verify-full` rather than Neon's default `require`: node-postgres already treats the
# two identically and warns on every run about `require` changing meaning in pg 9. Being
# explicit silences the warning and keeps the stronger behaviour when that release lands.
# The app uses this at runtime: serverless functions open a connection per cold start,
# which would exhaust a direct Postgres connection limit.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# The same database, direct (no pooler). Used by `prisma migrate`, the seed and the tests —
# DDL and long write batches are what pgbouncer transaction pooling handles worst.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# Session signing key (HS256). Must be >= 32 chars.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-at-least-32-random-characters-long"

# OAuth providers. Required — the app refuses to boot without them.
# Google:  https://console.cloud.google.com/apis/credentials
#          Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# GitHub:  https://github.com/settings/developers
#          Authorisation callback URL: http://localhost:3000/api/auth/callback/github
# On Vercel, add the deployed origin as a second redirect URI on each app.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
